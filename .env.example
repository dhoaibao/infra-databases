# Tailscale
TAILSCALE_IP=

# Postgres
PG_USER=
PG_PASSWORD=
PG_DB=

# Redis
REDIS_PASSWORD=

# Offsite backup (optional; leave OFFSITE_BACKUP empty to disable). See README.
# OFFSITE_STORAGE: s3 | r2 | oss. OFFSITE_BUCKET may include a path ("bucket/prefix").
# OFFSITE_ENDPOINT: host or http(s):// URL (required for r2 and oss). OFFSITE_REGION: required for s3 and oss.
# OFFSITE_PASSWORD encrypts the repository: losing it loses the backups, so store a copy elsewhere.
OFFSITE_BACKUP=
OFFSITE_STORAGE=
OFFSITE_BUCKET=
OFFSITE_ENDPOINT=
OFFSITE_REGION=
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=
OFFSITE_PASSWORD=

# Monitoring (optional). healthchecks.io ping URLs for the scheduled jobs; treat them as secrets. See README.
HEALTHCHECK_URL=
HEALTHCHECK_MAINTENANCE_URL=
